# Historical replay data. Market data is not distributed with this repository.
OPTION_WORKSTATION_DATA_ROOT=./data

# Local service binding. Keep 127.0.0.1 unless you intentionally add network controls.
OPTION_WORKSTATION_HOST=127.0.0.1
OPTION_WORKSTATION_PORT=7311

# Analytics configuration.
OPTION_WORKSTATION_RISK_FREE_RATE=0.043
OPTION_WORKSTATION_FRONTEND_DIST=./frontend/dist

# Schwab Market Data API.
# Create an app at developer.schwab.com and use the same callback URL in the portal.
# App Key is entered from the connection UI. Set App Secret here for browser OAuth start.
# OAuth completion uses the dedicated Callback URL field in the workstation UI.
# The legacy manual credential form can still pass App Secret to the local Rust process;
# credentials stay in process memory and are not persisted by the adapter.
OPTION_WORKSTATION_SCHWAB_APP_SECRET=
OPTION_WORKSTATION_SCHWAB_REDIRECT_URI=https://127.0.0.1:5556
# REST refresh cadence for quotes/options. Minimum enforced value is 2000 ms.
OPTION_WORKSTATION_SCHWAB_REFRESH_MS=3000

# Append-only local research ledger.
OPTION_WORKSTATION_AUDIT_PATH=./.option-workstation/audit.jsonl

# Schwab adapter is market-data only. Trader/account/order endpoints are not exposed or called.

RUST_LOG=option_workstation=info,tower_http=info
